name: 自动部署到 CF Worker

on:
  push:
    branches:
      - main
    paths:
      - '_worker.js'
      - 'wrangler.toml'
  workflow_dispatch:

jobs:
  auto-deploy:
    runs-on: ubuntu-latest
    env:
      USERNAME: ${{ secrets.USERNAME }}
      PASSWORD: ${{ secrets.PASSWORD }}
      TG_CHAT_ID: ${{ secrets.TG_CHAT_ID }}
      TG_BOT_TOKEN: ${{ secrets.TG_BOT_TOKEN }}

    steps:
      - name: ⬇️ 检出仓库
        uses: actions/checkout@v4

      - name: 🛠️ 安装 Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: 🆙 安装最新 Wrangler
        run: npm install -g wrangler@latest

      - name: 📝 读取项目名称
        id: config_setup
        run: |
          WORKER_NAME=$(grep '^name =' wrangler.toml | awk -F '"' '{print $2}')
          if [ -z "$WORKER_NAME" ]; then
            echo "::error file=wrangler.toml,line=1,title=❌ 配置错误::未能在 [wrangler.toml] 中找到 'name' 字段"
            exit 1
          fi
          echo "✅ 项目名称: $WORKER_NAME"
          echo "worker_name=$WORKER_NAME" >> $GITHUB_OUTPUT
          echo "--- wrangler.toml ---"
          cat wrangler.toml
          echo "--------------------"

      - name: ⚙️ 动态生成环境变量列表
        id: dynamic_vars
        run: |
          VARS=""

          if [ -n "$USERNAME" ] && [ -n "$PASSWORD" ]; then
            VARS+="USERNAME"$'\n'"PASSWORD"$'\n'
            echo "✅ 已载入登录凭证配置"
          else
            echo "::warning title=⚠️ 登录配置缺失::[Action Secrets] 中未设置 USERNAME/PASSWORD，默认值均为 admin"
          fi

          if [ -n "$TG_CHAT_ID" ] && [ -n "$TG_BOT_TOKEN" ]; then
            VARS+="TG_CHAT_ID"$'\n'"TG_BOT_TOKEN"$'\n'
            echo "✅ 已载入 Telegram 通知配置"
          else
            echo "::warning title=⚠️ TG 通知未启用::[Action Secrets] 中未设置 TG_CHAT_ID/TG_BOT_TOKEN，将无法发送通知"
          fi

          if [ -n "$VARS" ]; then
            printf 'vars_list<<EOF\n%sEOF\n' "$VARS" >> "$GITHUB_OUTPUT"
          else
            printf 'vars_list=\n' >> "$GITHUB_OUTPUT"
          fi

      - name: 🚀 部署到 Cloudflare
        uses: cloudflare/wrangler-action@v3
        with:
          apiToken: ${{ secrets.CF_API_TOKEN }}
          accountId: ${{ vars.CF_ACCOUNT_ID }}
          vars: ${{ steps.dynamic_vars.outputs.vars_list }}

      - name: ✨ 部署总结
        env:
          WORKER_NAME: ${{ steps.config_setup.outputs.worker_name }}
          ACCOUNT_ID: ${{ vars.CF_ACCOUNT_ID }}
        run: |
          echo ""
          echo "::notice title=🚀 部署成功::恭喜！您的 [$WORKER_NAME] 项目已上线"
          echo "🔗 CF管理后台 (点击直接跳转):"
          echo "https://dash.cloudflare.com/${ACCOUNT_ID}/workers/services/view/${WORKER_NAME}/production/settings"
          echo ""
          echo "::warning title=⚠️ 重要提示::必看以下说明!!!"
          echo "-----------------------------------------------------"
          echo "为了确保项目运行在最佳状态，建议检查以下配置："
          echo "🚀 绑定自定义域名"
          echo "🚀 开启 WebP 图片自动转换 (手动新增环境变量):"
          echo "    - 变量名: DOMAIN        值: 自定义域名"
          echo "    - 变量名: WEBP_ENABLED  值: true"
          echo "注意：完成上述步骤后，系统将自动识别并转换 WebP 格式"
          echo "-----------------------------------------------------"
          echo ""
          echo "::group::💡 其他可选环境变量（点击展开查看）"
          echo "- API_TOKEN: API接口密钥, 默认为 tgfile-admin, 用于自动化集成"
          echo "- COOKIE: COOKIE有效期, 默认为 7, 单位：天"
          echo "- ENABLE_AUTH: 是否启用登录, 默认为 true, 可设置为 false 禁用登录"
          echo "- TG_API_BASE: 自建 TG Bot API 地址，默认为官方API"
          echo "- MAX_SIZE_MB: 单文件大小限制 (默认 20)"
          echo "::endgroup::"